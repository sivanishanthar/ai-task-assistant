

OPENAI_API_KEY = your_api_key_here

# Per OpenAI completion request; automatic SDK retries are disabled.
API_TIMEOUT_MS=30000

# Per filesystem worker (all five tools).
WORKER_TIMEOUT_MS=10000

# Retained turns (including the active turn when making requests).
MAX_HISTORY_TURNS=20

# UTF-8 bytes of serialized message history, including system instructions.
MAX_HISTORY_BYTES=262144
